pipeline {

    agent any

    parameters {
        booleanParam(name: 'RUN_HIVE', defaultValue: true, description: 'Run Hive Fact Load')
    }


    environment {
        PG_URL    = "jdbc:postgresql://18.134.163.221:5432/marcpostgres"
        PG_USER   = "admin"
        PG_PASS   = "admin123"
        BASE_PATH = "/tmp/DE011025/Joe"

        HIVE_HOST = "ip-172-31-3-80.eu-west-2.compute.internal"
        HIVE_PORT = "10000"
        HIVE_DB   = "default"
        HIVE_USER = "Consultants"
        HIVE_PASS = "WelcomeItc@2022"

        HIVE_URL  = "jdbc:hive2://${HIVE_HOST}:${HIVE_PORT}/${HIVE_DB}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'marc_kick_returns_individual_task',
                    url: 'https://github.com/winnerstc/Football.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 --version
                    python3 -m pip install requirements.txt --upgrade pip --user
                '''
            }
        }
        stage('Sqoop INCREMENTAL Load') {
            when { expression { params.RUN_MODE == "INCREMENTAL" } }
            steps {
                sh """
                echo "INCREMENTAL INGESTION STARTED"
                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/mhanna_db --username Consultants --password WelcomeItc@2022 --table career_stats_kick_return --m 1 --target-dir /tmp/DE011025/marc/sqoop/career_stats_kick_return --fields-terminated-by ',' --lines-terminated-by '\n' --null-string '\\N' --null-non-string '\\N' --as-textfile
                echo "INCREMENTAL completed!!!"
                """
            }
        }

        stage('Run ETL Spark Job') {
    when { expression { params.RUN_MODE == "INCREMENTAL" } }
    steps {
        sh """
        spark-submit marc_ETL_task.py
        """
    }
   }
        # Run Unit tests
        stage('Run Tests') {
            steps {
                sh 'pytest -q || true'
            }
        }
    }
}
