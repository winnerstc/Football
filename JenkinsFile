pipeline {
    agent any
    options { timeout(time: 45, unit: 'MINUTES') }

       environment {
        /* --- your original vars --- */
        HADOOP_USER_NAME   = 'hdfs'
        GITHUB_REPO        = 'https://github.com/winnerstc/Football.git'   // fixed space
        PYTHON_SCRIPTS_DIR = 'Incremental'
        HIVE_JDBC_URL      = 'jdbc:hive2://ip-172-31-8-235.eu-west-2.compute.internal:10000/joepostgres'
        HIVE_USER          = 'Consultants'
        HIVE_PASSWORD      = 'WelcomeItc@2022'
        HIVE_FILE          = 'update_fact_player_stats.sql'
    
        /* --- cluster paths --- */
        HADOOP_CONF_DIR = "/etc/hadoop/conf"
        YARN_CONF_DIR   = "/etc/hadoop/conf"
        SPARK_HOME      = "/opt/cloudera/parcels/CDH/lib/spark"
        JAVA_HOME       = "/usr/lib/jvm/java-1.8.0"
        PATH            = "/opt/cloudera/parcels/CDH/bin:${env.PATH}"
    }
    
        
    stages {

        /* -------------------------------------------------
         * 1. Clone repository + verify scripts
         * ------------------------------------------------- */
        stage('Checkout Scripts') {
            steps {
                
                git branch: 'Development-Branch',
                    url: "${GITHUB_REPO}"

                sh """
                    echo "📁 Listing Python script directory"
                    ls -la ${PYTHON_SCRIPTS_DIR}
                """
            }
        }
  
        /* -------------------------------------------------
         * 2. Run Sqoop Imports
         * ------------------------------------------------- */
        stage('Run Sqoop Imports') {
            steps {
                sh """
                    echo "🚀 Starting Sqoop Imports"

                    for tbl in nfl_players nfl_rushing nfl_receiving nfl_defensive nfl_kicking nfl_passing nfl_returns
                    do
                        echo "➡️ Importing table: \$tbl"
                        sqoop import \
                            --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                            --username admin --password admin123 \
                            --table \$tbl -m 1 --as-parquetfile \
                            --target-dir /tmp/DE011025/Joe/incremental/\$tbl \
                            --delete-target-dir
                    done
                """
            }
        }

        /* -------------------------------------------------
         * 3. Run Spark ETL Scripts
         * ------------------------------------------------- */
        stage('Run Spark nfl players script') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_players_inc.py
                    '''
                }
            }
        stage('Run Spark nfl defensive script Job') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_defensive_inc.py
                    '''
                }
            }
        stage('Run Spark nfl kicking script Job') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_kicking_inc.py
                    '''
                }
            }
       stage('Run Spark nfl rushing script Job') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_rushing_inc.py
                    '''
                }
            }
        stage('Run Spark nfl receiving script Job') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_receiving_inc.py
                    '''
                }
            }
        stage('Run Spark nfl returns script Job') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_returns_inc.py
                    '''
                }
            }
        stage('Run Spark nfl passing script Job') {
                steps {
                    sh '''
                        echo "=== Using Spark Home: $SPARK_HOME ==="
                        echo "=== Using Hadoop Conf: $HADOOP_CONF_DIR ==="
            
                        spark-submit \
                            --master yarn \
                            --deploy-mode cluster \
                            Incremental/nfl_passing_inc.py
                    '''
                }
            }
        /* -------------------------------------------------
         * 4. Run Hive SQL script
         * ------------------------------------------------- */
        stage('Run Hive SQL Script') {
                steps {
                    sh '''
                    echo "🛢 Sanity-check SQL file"
                    wc -l "${HIVE_FILE}"
                    tail -10 "${HIVE_FILE}" || { echo "❌ SQL file missing/truncated"; exit 1; }
            
                    echo "🛢 Running Hive SQL file ${HIVE_FILE}"
                    beeline -u "${HIVE_JDBC_URL}" \
                        -n ${HIVE_USER} -p ${HIVE_PASSWORD} \
                        -f "${HIVE_FILE}"
                    '''
                }
            }

    post {
        success {
            echo '🎉 Pipeline finished successfully!'
        }
        failure {
            echo '❌ Pipeline failed – check the logs above.'
        }
    }
}
