pipeline {
    agent any
    options { timeout(time: 45, unit: 'MINUTES') }

    environment {
        HADOOP_USER_NAME   = 'hdfs'
        GITHUB_REPO        = 'https://github.com/winnerstc/Football.git'
        PYTHON_SCRIPTS_DIR = 'Incremental'

        HIVE_JDBC_URL      = 'jdbc:hive2://ip-172-31-8-235.eu-west-2.compute.internal:10000/joepostgres'
        HIVE_USER          = 'Consultants'
        HIVE_PASSWORD      = 'WelcomeItc@2022'
        HIVE_FILE          = 'update_fact_player_stats.sql'

        HADOOP_CONF_DIR = "/etc/hadoop/conf"
        YARN_CONF_DIR   = "/etc/hadoop/conf"
        SPARK_HOME      = "/opt/cloudera/parcels/CDH/lib/spark"
        JAVA_HOME       = "/usr/lib/jvm/java-1.8.0"
        PATH            = "/opt/cloudera/parcels/CDH/bin:${env.PATH}"
    }
stage('Install Python Dependencies') {
    steps {
        sh """
            echo '📦 Installing pytest...'
            python3 -m pip install --user pytest
        """
    }
}
    stages {

        stage('Checkout Scripts') {
            steps {
                git branch: 'Development-Branch', url: "${GITHUB_REPO}"

                sh """
                    echo '📁 Listing Python Scripts:'
                    ls -la ${PYTHON_SCRIPTS_DIR}
                """
            }
        }

        stage('Run Sqoop Imports') {
            steps {
                sh """
                    echo '🚀 Starting Sqoop Imports...'

                    for tbl in nfl_players nfl_rushing nfl_receiving nfl_defensive nfl_kicking nfl_passing nfl_returns
                    do
                        echo "➡️ Importing table: \$tbl"
                        sqoop import \
                            --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                            --username admin --password admin123 \
                            --table \$tbl -m 1 --as-parquetfile \
                            --target-dir /tmp/DE011025/Joe/incremental/\$tbl \
                            --delete-target-dir
                    done
                """
            }
        }

        stage('Run Spark ETL Jobs') {
            steps {
                script {
                    def jobs = [
                        "nfl_players_inc.py",
                        "nfl_defensive_inc.py",
                        "nfl_kicking_inc.py",
                        "nfl_rushing_inc.py",
                        "nfl_receiving_inc.py",
                        "nfl_returns_inc.py",
                        "nfl_passing_inc.py"
                    ]

                    jobs.each { job ->
                        sh """
                            echo "🔥 Running Spark Job: ${job}"

                            spark-submit \
                                /*--master yarn \
                                --deploy-mode cluster \ */
                                ${PYTHON_SCRIPTS_DIR}/${job}
                        """
                    }
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh """
                    echo '🧪 Running Full Test Suite...'
                    pytest 'unit tests/full_test_nfl_21_tests.py'

                    echo '🧪 Running All 7 Transform Tests...'
                    pytest 'unit tests/test_all_7_transforms.py'
                """
            }
        }

        stage('Run Hive SQL Script') {
            steps {
                sh """
                    echo '🛢 Validating SQL file'
                    wc -l "${HIVE_FILE}"
                    tail -10 "${HIVE_FILE}" || { echo '❌ SQL file missing'; exit 1; }

                    echo '🛢 Executing Hive SQL Script...'
                    beeline -u "${HIVE_JDBC_URL}" -f "${HIVE_FILE}"
                """
            }
        }

    }   // <-- END OF STAGES BLOCK

    post {
        success {
            echo '🎉 Pipeline finished successfully!'
        }
        failure {
            echo '❌ Pipeline failed — check logs.'
        }
    }
}   // <-- END OF PIPELINE
