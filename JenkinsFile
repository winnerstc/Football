pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/winnerstc/Football.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 --version
                    python3 -m pip install --upgrade pip
                    python3 -m pip install pandas numpy requests boto3 pytest
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh 'pytest -q || true'
            }
        }
    }
}
