pipeline {
    agent any

    environment {
        HADOOP_USER_NAME = 'hdfs'
        GITHUB_REPO = 'https://github.com/winnerstc/Football.git'
        PYTHON_SCRIPTS_DIR = 'Incremental'
        HIVE_JDBC_URL = 'jdbc:hive2://ip-172-31-3-80.eu-west-2.compute.internal:10000/joepostgres'
        HIVE_USER = 'admin'
        HIVE_PASSWORD = 'admin123'
        HIVE_FILE = 'update_fact_player_stats.sql'
    }

    stages {

        /*---------------------------------------------------
         * CHECKOUT REPO
         *---------------------------------------------------*/
        stage('Checkout GitHub Repo') {
            steps {
                git branch: 'Development-Branch', url: "${GITHUB_REPO}"
            }
        }

        /*---------------------------------------------------
         * SQOOP IMPORT STAGE
         *---------------------------------------------------*/
        stage('Run Sqoop Imports') {
            steps {
                sh """
                set -e

                echo "Starting Sqoop Imports..."

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_players --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_players --delete-target-dir

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_rushing --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_rushing --delete-target-dir

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_receiving --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_receiving --delete-target-dir

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_defensive --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_defensive --delete-target-dir

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_kicking --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_kicking --delete-target-dir

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_passing --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_passing --delete-target-dir

                sqoop import --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table nfl_returns --m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/nfl_returns --delete-target-dir

                echo "Sqoop Imports Completed Successfully!"
                """
            }
        }

        /*---------------------------------------------------
         * SPARK STAGE
         *---------------------------------------------------*/
        stage('Run Spark Scripts') {
            steps {
                sh """
                set -e

                echo "Starting Spark Incremental Jobs..."

                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_players_inc.py
                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_rushing_inc.py
                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_receiving_inc.py
                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_defensive_inc.py
                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_kicking_inc.py
                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_passing_inc.py
                spark-submit ${PYTHON_SCRIPTS_DIR}/nfl_returns_inc.py

                echo "Spark Jobs Completed Successfully!"
                """
            }
        }

        /*---------------------------------------------------
         * HIVE SQL STAGE
         *---------------------------------------------------*/
        stage('Run Hive SQL Script') {
            steps {
                sh """
                set -e

                echo "Running Hive SQL Script..."

                beeline -u "${HIVE_JDBC_URL}" \
                    -n ${HIVE_USER} \
                    -p ${HIVE_PASSWORD} \
                    -f ${HIVE_FILE}

                echo "Hive Script Completed Successfully!"
                """
            }
        }
    }

    /*---------------------------------------------------
     * POST ACTIONS
     *---------------------------------------------------*/
    post {
        success {
            echo "🎉 Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed — check logs."
        }
    }
}
