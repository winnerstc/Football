pipeline {
    agent any

    stages {
        
        stage('Install Requirements') {
            steps {
                sh 'python3 -m pip install --user -r test.py'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'python3 -m pytest'
            }
        }

        stage('Build') {
            steps {
                echo "Building the application..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying the application..."
            }
        }
    }
}
