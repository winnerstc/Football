pipeline {
    agent any
    options { timeout(time: 45, unit: 'MINUTES') }

    environment {
        HADOOP_USER_NAME   = 'hdfs'
        GITHUB_REPO        = 'https://github.com/winnerstc/Football.git'
        PYTHON_SCRIPTS_DIR = 'Incremental'   // folder inside the repo
        HIVE_JDBC_URL      = 'jdbc:hive2://ip-172-31-3-80.eu-west-2.compute.internal:10000/joepostgres'
        HIVE_USER          = 'admin'
        HIVE_PASSWORD      = 'admin123'
        HIVE_FILE          = 'update_fact_player_stats.sql'
    }

    stages {
        /* -------------------------------------------------
         * 1.  pull scripts from GitHub
         * ------------------------------------------------- */
        stage('Checkout Scripts') {
            steps {
                git branch: 'Development-Branch',
                    url: "${GITHUB_REPO}"
                sh 'ls -la ${PYTHON_SCRIPTS_DIR}   # sanity check'
            }
        }

        /* -------------------------------------------------
         * 2.  Sqoop imports (your existing commands)
         * ------------------------------------------------- */
        stage('Run Sqoop Imports') {
            steps {
                sh '''
                for tbl in nfl_players nfl_rushing nfl_receiving nfl_defensive nfl_kicking nfl_passing nfl_returns
                do
                  sqoop import \
                    --connect jdbc:postgresql://18.134.163.221:5432/joepostgres \
                    --username admin --password admin123 \
                    --table $tbl -m 1 --as-parquetfile \
                    --target-dir /tmp/DE011025/Joe/incremental/$tbl \
                    --delete-target-dir
                done
                '''
            }
        }

        /* -------------------------------------------------
         * 3.  Spark scripts from GitHub
         * ------------------------------------------------- */
        stage('Run Spark Scripts') {
            steps {
                sh '''
                hdfs dfs -ls /tmp/DE011025/Joe/incremental || { echo "HDFS path missing"; exit 1; }
                for script in nfl_players nfl_rushing nfl_receiving nfl_defensive nfl_kicking nfl_passing nfl_returns
                do
                  sudo -E -u hdfs spark-submit \
                    --master yarn \
                    --deploy-mode cluster \
                    ${PYTHON_SCRIPTS_DIR}/${script}_inc.py
                done
                '''
            }
        }

        /* -------------------------------------------------
         * 4.  Hive update
         * ------------------------------------------------- */
        stage('Run Hive SQL Script') {
            steps {
                sh """
                beeline -u \"${HIVE_JDBC_URL}\" \
                  -n ${HIVE_USER} -p ${HIVE_PASSWORD} \
                  -f ${HIVE_FILE}
                """
            }
        }
    }

    post {
        success { echo '🎉 Pipeline finished' }
        failure { echo '❌ Pipeline failed – see logs above' }
    }
}
