pipeline {
    agent any

    stages {


        stage('Run Tests') {
            steps {
                sh 'pytest'
            }
        }

        stage('Build') {
            steps {
                echo "Building application..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying to server..."
                // Example: sh 'scp -r . user@server:/app/'
            }
        }
    }
}
