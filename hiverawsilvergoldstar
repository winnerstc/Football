-- 1.  create new corrected data set
-- 1.  rows that need fixing
CREATE TABLE fix_college
STORED AS ORC
AS
SELECT f.player_key,
       p.college AS college_key
FROM   Fact_Player_Stats f
JOIN   nfl_players_silver p
  ON   CAST(p.player_id AS INT) = f.player_key
WHERE  f.college_key IS NULL;

-- 2.  overwrite the affected rows
INSERT OVERWRITE TABLE Fact_Player_Stats
SELECT /*+ STREAMTABLE(fix_college) */
       f.player_key,
       COALESCE(fc.college_key, f.college_key)  AS college_key,
       f.team_key,
       f.position_key,
       f.passing_yards,
       f.passing_tds,
       f.rushing_yards,
       f.rushing_tds,
       f.receiving_yards,
       f.receiving_tds,
       f.total_tackles,
       f.sacks,
       f.ints,
       f.fgs_made,
       f.kick_return_tds,
       f.punt_return_tds,
       f.years_played,
       f.good_years
FROM   Fact_Player_Stats f
LEFT JOIN fix_college fc
       ON f.player_key = fc.player_key;
       
